<?xml version="1.0" ?>
<mujoco model="URDF_Model_rough">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001"/>
  <!-- Match the reference plane model's default viewer framing.  This only
       defines MuJoCo's scene statistics; it does not control the camera at
       runtime or change the robot dynamics. -->
  <statistic center="0 -4 0" extent="20"/>
  <asset>
    <mesh name="base_link" file="../meshes/base_link.STL"/>
    <mesh name="joint1_Link" file="../meshes/joint1_Link.STL"/>
    <mesh name="joint2_Link" file="../meshes/joint2_Link.STL"/>
    <mesh name="joint3_Link" file="../meshes/joint3_Link.STL"/>
    <mesh name="joint4_Link" file="../meshes/joint4_Link.STL"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" mark="edge" markrgb=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    <material name="self" rgba=".7 .5 .3 1"/>
    <texture name="wheel_tread_texture" type="2d" builtin="checker" rgb1=".85 .55 .62" rgb2="1 .75 .8" width="32" height="32"/>
    <material name="wheel_tread_material" texture="wheel_tread_texture" texrepeat="12 12" texuniform="true"/>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1=".4 .6 .8" rgb2="0 0 0" width="800" height="800" mark="random" markrgb="1 1 1"/>
    <texture name="stripe_texture" type="2d" builtin="checker" rgb1="0.7 0.7 0.7" rgb2="0.4 0.4 0.4" width="300" height="300"/>
    <material name="stripe_material" texture="stripe_texture" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    <!-- Match the source sim2sim scene: the checked-in PNG is the original
         agent_eval_gym heightmap and its vertical range is 0.4 m. -->
    <hfield name="rough_terrain" file="../terrain/agent_eval_gym.png" size="10.5 10.5 0.4 0.1"/>
  </asset>
  <visual>
    <headlight ambient=".3 .3 .3" diffuse=".6 .6 .6" specular="0.1 0.1 0.1"/>
    <map znear=".01"/>
    <quality shadowsize="2048"/>
  </visual>
  <worldbody>
    <!-- The plane and rough patch are separate neighboring regions.  Do not
         place an infinite plane under the heightfield: the two surfaces
         would overlap visually and create competing contacts in low spots. -->
    <!-- z=0 plane sections outside the 21 m heightfield patch.  They provide
         the flat starting area before x=0.5 and flat ground after x=21.5. -->
    <geom name="plane_left_collision" type="box" pos="-49.75 0 -0.02" size="50.25 100 0.02" material="grid" condim="3" friction="1.0 0.005 0.01"/>
    <geom name="plane_right_collision" type="box" pos="60.75 0 -0.02" size="39.25 100 0.02" material="grid" condim="3" friction="1.0 0.005 0.01"/>
    <geom name="plane_back_collision" type="box" pos="11 -60.75 -0.02" size="10.5 39.25 0.02" material="grid" condim="3" friction="1.0 0.005 0.01"/>
    <geom name="plane_front_collision" type="box" pos="11 49.75 -0.02" size="10.5 50.25 0.02" material="grid" condim="3" friction="1.0 0.005 0.01"/>
    <geom name="rough_terrain" type="hfield" hfield="rough_terrain" pos="11 -11 0" size="10.5 10.5 0.4" group="1" condim="3" friction="1.0 0.005 0.01"/>
    <!-- Rear obstacle test: 0.08 m high and 1.6 m wide.  It spans both
         wheels and sits on the z=0 plane behind the initial robot pose. -->
    <geom name="rear_test_step" type="box" pos="-2.00 -1.50 0.040000" size="0.15 0.70 0.040000" material="stripe_material" condim="3" friction="1.0 0.005 0.01"/>
    <light name="side" pos="1 1 1" dir="-1 -1 -1" directional="true"/>
    <!-- The spawn pose is kept over the same source-scene heightfield datum;
         set_equilibrium_pose places the wheel mesh on the local ground. -->
    <!-- Start on the z=0 plane immediately before the source terrain patch.
         The heightfield spans x=[0.5, 21.5] at this y, so the robot enters
         the rough section continuously instead of spawning inside it. -->
    <body name="base_link" pos="-1.00 -1.50 0.1950">
      <freejoint name="floating_base"/>
      <inertial pos="-0.019944 -5.2713e-09 -0.013316" mass="8.0119" fullinertia="0.053692 0.053191 0.053501 5.1696E-09 2.892E-07 -9.2023E-10"/>
      <geom name="base_link_visual_0" rgba="0.2 0.8 0.8 1" group="0" type="mesh" mesh="base_link" contype="1" conaffinity="1"/>
      <site name="imu_site" pos="0 0 0" size="0.005" rgba="1 0 0 1"/>
      <body name="joint1_Link" pos="-0.01994 -0.11 -0.093022">
        <joint name="joint1" type="hinge" axis="0 -1 0" limited="false"/>
        <inertial pos="-1.8978e-15 -0.01 0.048127" mass="0.3785" fullinertia="0.0031507 0.0059232 0.0027977 -5.0101E-22 2.9739E-18 1.1853E-21"/>
        <geom name="joint1_Link_visual_0" rgba="1 1 1 1" group="0" type="mesh" mesh="joint1_Link" contype="0" conaffinity="0"/>
        <body name="joint2_Link" pos="0 0 0.06">
          <joint name="joint2" type="hinge" axis="0 1 0" limited="false"/>
          <inertial pos="3.4694e-18 -0.01 -4.8572e-17" mass="0.36628" fullinertia="0.0041365 0.0082496 0.0041365 2.5896E-36 2.8912E-19 -1.3156E-35"/>
          <geom name="joint2_Link_visual_0" material="wheel_tread_material" group="0" type="mesh" mesh="joint2_Link" contype="0" conaffinity="0"/>
          <geom name="right_wheel_collision" type="cylinder" pos="0 -0.01 0" size="0.16 0.01" euler="1.57079632679 0 0" friction="1.0 0.005 0.01" condim="3" group="3" rgba="0 0 0 0"/>
        </body>
      </body>
      <body name="joint3_Link" pos="-0.01994 0.13 -0.093022">
        <joint name="joint3" type="hinge" axis="0 1 0" limited="false"/>
        <inertial pos="-4.6387e-15 -0.01 0.048127" mass="0.3785" fullinertia="0.0031507 0.0059232 0.0027977 -1.7058E-20 2.9749e-18 3.0729e-20"/>
        <geom name="joint3_Link_visual_0" rgba="1 1 1 1" group="0" type="mesh" mesh="joint3_Link" contype="0" conaffinity="0"/>
        <body name="joint4_Link" pos="0 0 0.06">
          <joint name="joint4" type="hinge" axis="0 -1 0" limited="false"/>
          <inertial pos="3.4694e-18 -0.01 -4.8572e-17" mass="0.36628" fullinertia="0.0041365 0.0082496 0.0041365 3.614E-20 2.8919e-19 -3.2789e-35"/>
          <geom name="joint4_Link_visual_0" material="wheel_tread_material" group="0" type="mesh" mesh="joint4_Link" contype="0" conaffinity="0"/>
          <geom name="left_wheel_collision" type="cylinder" pos="0 -0.01 0" size="0.16 0.01" euler="1.57079632679 0 0" friction="1.0 0.005 0.01" condim="3" group="3" rgba="0 0 0 0"/>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="base_link" body2="joint2_Link"/>
    <exclude body1="base_link" body2="joint4_Link"/>
  </contact>
  <sensor>
    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_acc" site="imu_site"/>
    <framequat name="imu_quat" objtype="site" objname="imu_site"/>
    <frameangvel name="imu_angvel" objtype="site" objname="imu_site"/>
  </sensor>
  <actuator>
    <motor name="j1_ctrl" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-10 10" forcerange="-10 10"/>
    <motor name="j3_ctrl" joint="joint3" gear="1" ctrllimited="true" ctrlrange="-10 10" forcerange="-10 10"/>
    <motor name="j2_ctrl" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-5 5" forcerange="-5 5"/>
    <motor name="j4_ctrl" joint="joint4" gear="1" ctrllimited="true" ctrlrange="-5 5" forcerange="-5 5"/>
  </actuator>
</mujoco>
